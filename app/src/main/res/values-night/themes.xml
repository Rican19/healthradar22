<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme variant - this overrides the main theme in night mode -->
    <style name="Theme.HealthRadar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors for dark mode -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors for dark mode -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color for dark mode -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- TEXT COLOR ATTRIBUTES - ADD THESE FOR DARK MODE -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_disabled</item>

        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.HealthRadar.Button.Dark</item>
        <item name="textInputStyle">@style/Widget.HealthRadar.TextInputLayout.Dark</item>
    </style>

    <!-- Dark Mode Button -->
    <style name="Widget.HealthRadar.Button.Dark" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Dark Mode TextInputLayout -->
    <style name="Widget.HealthRadar.TextInputLayout.Dark" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">@color/gray</item>
        <item name="hintTextColor">@color/gray</item>
        <item name="android:textColorHint">@color/gray</item>
    </style>
</resources>