<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingVertical="4dp">

    <!-- Disease Name - MUST be 120dp EXACT -->
    <TextView
        android:id="@+id/tvDiseaseName"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="8dp"
        android:text="Dengue Fever"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Cases - MUST be 60dp EXACT -->
    <TextView
        android:id="@+id/tvCases"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:text="25"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:maxLines="1" />

    <!-- Municipality - MUST be 100dp EXACT -->
    <TextView
        android:id="@+id/tvMunicipality"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="8dp"
        android:text="Manila City"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Date - MUST be 90dp EXACT -->
    <TextView
        android:id="@+id/tvDateReported"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="8dp"
        android:text="2024-01-15"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>